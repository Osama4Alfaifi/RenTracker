rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // لا توجد شاشة تسجيل عام — الحسابات تُنشأ يدويًا من Firebase Console،
    // فأي مستخدم موثّق (مسجّل دخول) هو مستخدم موثوق به.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
